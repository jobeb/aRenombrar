# Build / distribución
aRenombrar/build/
aRenombrar/dist/
aRenombrar/__pycache__/
aRenombrar/**/__pycache__/
*.pyc
*.pyo
*.spec.bak

# Logs de diagnóstico y de ejecución local (contienen IPs/rutas del
# equipo del usuario -- nunca deben acabar en el repo)
aRenombrar/diagnostico.log
/*.log
/*.log.*

# Artefactos de build ya descargados a mano (instaladores/.dmg de
# prueba) -- no pertenecen al repo, son binarios grandes
aRenombrar/macos_dl/

# Marcador de lanzar.vbs -- evita reinstalar dependencias en cada
# arranque si requirements.txt no ha cambiado
aRenombrar/.deps_installed

# Config local (contiene contraseñas FTP y API keys)
# El archivo real vive en %APPDATA%\aRenombrar\config.json
aRenombrar/auto_processed.json

# Entornos virtuales
.venv/
venv/
env/

# IDEs
.vscode/
.idea/
*.suo
*.user
